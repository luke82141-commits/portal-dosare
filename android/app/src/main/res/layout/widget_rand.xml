<?xml version="1.0" encoding="utf-8"?>
<!-- Un rând din listele widgeturilor mediu și mare (ListView derulabil). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r_rand"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/w_rand"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/r_zi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/w_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/r_ora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/w_auriu"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/r_dosar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/w_primar"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/r_inst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_text2"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
