            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/w_verde"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
