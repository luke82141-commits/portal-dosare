<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radacina"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fundal"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/g_titlu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="TERMENE ÎN 7 ZILE"
            android:textColor="@color/w_auriu"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/g_act"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/w_pastila"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/w_verde"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lista derulabilă umple tot spațiul rămas, oricât de mare e widgetul. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/g_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/g_gol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TEXTg_gol"
            android:textColor="@color/w_text2"
            android:textSize="13sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/g_act_titlu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="ULTIMELE ACTUALIZĂRI"
        android:textColor="@color/w_auriu"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/ga0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ga0_dosar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/w_primar"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ga0_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_verde"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ga1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ga1_dosar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/w_primar"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ga1_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_verde"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/g_actualizat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:textColor="@color/w_text2"
        android:textSize="10sp" />
</LinearLayout>
